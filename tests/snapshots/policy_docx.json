      "text": "Passwords",
      "type": "heading"
    },
    {
      "text": "Passwords must be at least 12 characters and rotate every 90 days.",
      "type": "paragraph"
    },
    {
      "level": 1,
      "text": "Use a password manager",
      "type": "list_item"
    },
    {
      "level": 1,
