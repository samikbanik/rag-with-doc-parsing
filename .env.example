# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=sk-...

# Local docker-compose defaults; override for other environments.
RAGCHAT_DATABASE_URL=postgresql+asyncpg://ragchat:ragchat@localhost:5432/ragchat
RAGCHAT_QDRANT_URL=http://localhost:6333

# Optional overrides of config/settings.yaml
# RAGCHAT_LLM__MODEL=gpt-4.1
# RAGCHAT_EMBEDDING__DIMENSIONS=1024
